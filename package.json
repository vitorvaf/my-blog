  "scripts": {
    "build": "gatsby build",
    "develop": "gatsby develop -p 8888",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "lint": "eslint \"src/**/*.{js,jsx,tsx}\" gatsby-*.js",
    "start": "npm run develop",
    "serve": "gatsby serve",
    "clean": "gatsby clean",
    "test": "jest",
    "prepare": "husky install"
