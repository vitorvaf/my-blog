# Copy this file to `.env` (or `.env.development` / `.env.production`) and
# fill in real values. Never commit the actual `.env*` files.

# --- Algolia ---
# Build-time only, used by gatsby-plugin-algolia (gatsby-config.js) to push
# the search index during `gatsby build`. Keep the admin key secret: it must
# NOT be prefixed with GATSBY_ or it will be exposed to the client bundle.
GATSBY_ALGOLIA_APP_ID=
ALGOLIA_ADMIN_KEY=
GATSBY_ALGOLIA_INDEX_NAME=

# Public, read-only search key, exposed to the browser (GATSBY_ prefix) and
# used by src/components/Search to query Algolia from the client.
GATSBY_ALGOLIA_SEARCH_KEY=
